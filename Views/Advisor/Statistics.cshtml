@model Dictionary<string, int>
@{
    ViewData["Title"] = "İstatistikler";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Staj Takip — İstatistikler</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <style>
        body {
            background: #f0f4f8;
        }

        .sidebar {
            background: linear-gradient(180deg, #3d1a6e, #6f42c1);
            min-height: 100vh;
            width: 240px;
            position: fixed;
            top: 0;
            left: 0;
            padding: 1.5rem 1rem;
            z-index: 100;
        }

            .sidebar .nav-link {
                color: rgba(255,255,255,0.75);
                border-radius: 8px;
                padding: 0.6rem 1rem;
                margin-bottom: 4px;
                transition: all 0.2s;
            }

                .sidebar .nav-link:hover, .sidebar .nav-link.active {
                    background: rgba(255,255,255,0.15);
                    color: #fff;
                }

        .main-content {
            margin-left: 240px;
            padding: 2rem;
        }

        .stat-card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.07);
        }

        .stat-icon {
            width: 48px;
            height: 48px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
        }
    </style>
</head>
<body>

    <div class="sidebar">
        <div class="text-white text-center mb-4">
            <i class="bi bi-person-badge-fill fs-3"></i>
            <div class="fw-bold mt-1">Staj Takip</div>
            <small class="opacity-75">@User.Identity?.Name</small>
        </div>
        <nav class="nav flex-column">
            <a href="/Advisor/Dashboard" class="nav-link">
                <i class="bi bi-speedometer2 me-2"></i>Dashboard
            </a>
            <a href="/Advisor/Students" class="nav-link">
                <i class="bi bi-people me-2"></i>Öğrencilerim
            </a>
            <a href="/Advisor/PendingApprovals" class="nav-link">
                <i class="bi bi-hourglass-split me-2"></i>Onay Bekleyenler
            </a>
            <a href="/Advisor/Statistics" class="nav-link active">
                <i class="bi bi-bar-chart me-2"></i>İstatistikler
            </a>
        </nav>
        <div class="position-absolute bottom-0 start-0 w-100 p-3">
            <a href="/Advisor/Profile" class="nav-link">
                <i class="bi bi-person-circle me-2"></i>Profilim
            </a>
            <a href="/Message/Inbox" class="nav-link">
                <i class="bi bi-chat-dots me-2"></i>Mesajlar
            </a>
            <a href="/Account/Logout" class="nav-link text-white-50">
                <i class="bi bi-box-arrow-left me-2"></i>Çıkış Yap
            </a>
        </div>
    </div>

    <div class="main-content">

        <div class="mb-4">
            <h4 class="fw-bold mb-0">İstatistikler</h4>
            <small class="text-muted">Öğrencilerinizin staj süreç özeti</small>
        </div>

        <!-- Özet kartlar -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-lg-3">
                <div class="card stat-card p-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="stat-icon bg-primary bg-opacity-10">
                            <i class="bi bi-collection text-primary"></i>
                        </div>
                        <div>
                            <div class="fw-bold fs-4">@(Model?.GetValueOrDefault("Toplam", 0))</div>
                            <div class="small text-muted">Toplam</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card stat-card p-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="stat-icon bg-success bg-opacity-10">
                            <i class="bi bi-check-circle text-success"></i>
                        </div>
                        <div>
                            <div class="fw-bold fs-4">@(Model?.GetValueOrDefault("Onaylanan", 0))</div>
                            <div class="small text-muted">Onaylanan</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card stat-card p-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="stat-icon bg-warning bg-opacity-10">
                            <i class="bi bi-hourglass text-warning"></i>
                        </div>
                        <div>
                            <div class="fw-bold fs-4">@(Model?.GetValueOrDefault("Bekleyen", 0))</div>
                            <div class="small text-muted">Bekleyen</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card stat-card p-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="stat-icon bg-info bg-opacity-10">
                            <i class="bi bi-chat-dots text-info"></i>
                        </div>
                        <div>
                            <div class="fw-bold fs-4">@(Model?.GetValueOrDefault("Mülakat", 0))</div>
                            <div class="small text-muted">Mülakat</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Grafik -->
        <div class="card stat-card p-4">
            <h6 class="fw-bold mb-4">Başvuru Dağılımı</h6>
            <div style="max-width: 400px; margin: 0 auto;">
                <canvas id="statsChart"></canvas>
            </div>
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const ctx = document.getElementById('statsChart').getContext('2d');
        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: ['Bekleyen', 'Mülakat', 'Kabul', 'Reddedilen', 'Danışman Onaylı'],
                datasets: [{
                            data: [
            @(Model?.GetValueOrDefault("Bekleyen", 0)),
            @(Model?.GetValueOrDefault("Mülakat", 0)),
            @(Model?.GetValueOrDefault("Kabul", 0)),
            @(Model?.GetValueOrDefault("Reddedilen", 0)),
            @(Model?.GetValueOrDefault("Onaylanan", 0))
        ],
        labels: ['Bekleyen', 'Mülakat', 'Kabul', 'Reddedilen', 'Danışman Onaylı'],
                    backgroundColor: [
                        'rgba(25, 135, 84, 0.8)',
                        'rgba(255, 193, 7, 0.8)',
                        'rgba(220, 53, 69, 0.8)',
                        'rgba(13, 110, 253, 0.8)',
                        'rgba(13, 202, 240, 0.8)'
                    ],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { position: 'bottom' }
                }
            }
        });
    </script>
</body>
</html>
