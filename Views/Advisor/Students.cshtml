@model List<StajTakip.Entities.Concrete.User>
@{
    ViewData["Title"] = "Öğrencilerim";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Staj Takip — Öğrencilerim</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        body {
            background: #f0f4f8;
        }

        .sidebar {
            background: linear-gradient(180deg, #3d1a6e, #6f42c1);
            min-height: 100vh;
            width: 240px;
            position: fixed;
            top: 0;
            left: 0;
            padding: 1.5rem 1rem;
            z-index: 100;
        }

            .sidebar .nav-link {
                color: rgba(255,255,255,0.75);
                border-radius: 8px;
                padding: 0.6rem 1rem;
                margin-bottom: 4px;
                transition: all 0.2s;
            }

                .sidebar .nav-link:hover, .sidebar .nav-link.active {
                    background: rgba(255,255,255,0.15);
                    color: #fff;
                }

        .main-content {
            margin-left: 240px;
            padding: 2rem;
        }

        .student-card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.07);
            transition: transform 0.2s;
        }

            .student-card:hover {
                transform: translateY(-2px);
            }

        .avatar {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: #6f42c1;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: bold;
            font-size: 1.2rem;
        }
    </style>
</head>
<body>

    <div class="sidebar">
        <div class="text-white text-center mb-4">
            <i class="bi bi-person-badge-fill fs-3"></i>
            <div class="fw-bold mt-1">Staj Takip</div>
            <small class="opacity-75">@User.Identity?.Name</small>
        </div>
        <nav class="nav flex-column">
            <a href="/Advisor/Dashboard" class="nav-link">
                <i class="bi bi-speedometer2 me-2"></i>Dashboard
            </a>
            <a href="/Advisor/Students" class="nav-link active">
                <i class="bi bi-people me-2"></i>Öğrencilerim
            </a>
            <a href="/Advisor/PendingApprovals" class="nav-link">
                <i class="bi bi-hourglass-split me-2"></i>Onay Bekleyenler
            </a>
            <a href="/Advisor/Statistics" class="nav-link">
                <i class="bi bi-bar-chart me-2"></i>İstatistikler
            </a>
        </nav>
        <div class="position-absolute bottom-0 start-0 w-100 p-3">
            <a href="/Advisor/Profile" class="nav-link">
                <i class="bi bi-person-circle me-2"></i>Profilim
            </a>
            <a href="/Message/Inbox" class="nav-link">
                <i class="bi bi-chat-dots me-2"></i>Mesajlar
            </a>
            <a href="/Account/Logout" class="nav-link text-white-50">
                <i class="bi bi-box-arrow-left me-2"></i>Çıkış Yap
            </a>
        </div>
    </div>

    <div class="main-content">

        <div class="mb-4">
            <h4 class="fw-bold mb-0">Öğrencilerim</h4>
            <small class="text-muted">Danışmanlığını yaptığınız öğrenciler</small>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="row g-3">
                @foreach (var student in Model)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card student-card p-4">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div class="avatar">@student.FullName[0]</div>
                                <div>
                                    <div class="fw-bold">@student.FullName</div>
                                    <div class="text-muted small">@student.Email</div>
                                </div>
                            </div>
                            <div class="d-flex gap-3 text-muted small mb-3">
                                <span><i class="bi bi-hash me-1"></i>@(student.StudentNumber ?? "-")</span>
                                <span><i class="bi bi-book me-1"></i>@(student.Department ?? "-")</span>
                            </div>
                            <a href="/Advisor/PendingApprovals"
                               class="btn btn-sm btn-outline-primary rounded-pill w-100">
                                <i class="bi bi-hourglass-split me-1"></i>Onay Bekleyenleri Gör
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="card border-0 rounded-3 shadow-sm">
                <div class="card-body text-center py-5 text-muted">
                    <i class="bi bi-people fs-1 d-block mb-3"></i>
                    <h6>Henüz öğrenciniz yok</h6>
                    <p class="small">Öğrenciler kayıt olurken sizi danışman olarak seçecek.</p>
                </div>
            </div>
        }

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>