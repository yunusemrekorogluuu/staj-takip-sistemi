@model List<StajTakip.Entities.Concrete.InternshipPost>
@{
    ViewData["Title"] = "Staj İlanları";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Staj Takip — Staj İlanları</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        body {
            background: #f0f4f8;
        }

        .sidebar {
            background: linear-gradient(180deg, #1e3a5f, #2e86de);
            min-height: 100vh;
            width: 240px;
            position: fixed;
            top: 0;
            left: 0;
            padding: 1.5rem 1rem;
            z-index: 100;
        }

            .sidebar .nav-link {
                color: rgba(255,255,255,0.75);
                border-radius: 8px;
                padding: 0.6rem 1rem;
                margin-bottom: 4px;
                transition: all 0.2s;
            }

                .sidebar .nav-link:hover, .sidebar .nav-link.active {
                    background: rgba(255,255,255,0.15);
                    color: #fff;
                }

        .main-content {
            margin-left: 240px;
            padding: 2rem;
        }

        .post-card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.07);
            transition: transform 0.2s;
        }

            .post-card:hover {
                transform: translateY(-2px);
            }
    </style>
</head>
<body>

    <div class="sidebar">
        <div class="text-white text-center mb-4">
            <i class="bi bi-briefcase-fill fs-3"></i>
            <div class="fw-bold mt-1">Staj Takip</div>
            <small class="opacity-75">@User.Identity?.Name</small>
        </div>
        <nav class="nav flex-column">
            <a href="/Student/Dashboard" class="nav-link">
                <i class="bi bi-speedometer2 me-2"></i>Dashboard
            </a>
            <a href="/Student/Applications" class="nav-link">
                <i class="bi bi-list-ul me-2"></i>Başvurularım
            </a>
            <a href="/Student/Internships" class="nav-link active">
                <i class="bi bi-search me-2"></i>Staj İlanları
            </a>
            <a href="/Student/Internships" class="nav-link">
                <i class="bi bi-search me-2"></i>Staj İlanları
            </a>
            <a href="/Student/AddApplication" class="nav-link active">
                <i class="bi bi-plus-circle me-2"></i>Manuel Başvuru
            </a>
        </nav>
        <div class="position-absolute bottom-0 start-0 w-100 p-3">
            <a href="/Student/Profile" class="nav-link">
                <i class="bi bi-person-circle me-2"></i>Profilim
            </a>
            <a href="/Message/Inbox" class="nav-link">
                <i class="bi bi-chat-dots me-2"></i>Mesajlar
            </a>
            <a href="/Account/Logout" class="nav-link text-white-50">
                <i class="bi bi-box-arrow-left me-2"></i>Çıkış Yap
            </a>
        </div>
    </div>

    <div class="main-content">

        <div class="mb-4">
            <h4 class="fw-bold mb-0">Staj İlanları</h4>
            <small class="text-muted">Şirketlerin yayınladığı aktif staj pozisyonları</small>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="row g-3">
                @foreach (var post in Model)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card post-card h-100 p-4">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h6 class="fw-bold mb-1">@post.Title</h6>
                                    <div class="text-muted small">@(post.Company?.CompanyName ?? "-")</div>
                                </div>
                                <span class="badge bg-success bg-opacity-10 text-success" style="font-size:0.75rem">
                                    <i class="bi bi-circle-fill me-1" style="font-size:0.5rem"></i>Aktif
                                </span>
                            </div>

                            <div class="text-muted small mb-3" style="display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden">
                                @post.Description
                            </div>

                            <div class="d-flex gap-3 text-muted small mb-3">
                                @if (!string.IsNullOrEmpty(post.City))
                                {
                                    <span><i class="bi bi-geo-alt me-1"></i>@post.City</span>
                                }
                                @if (!string.IsNullOrEmpty(post.Department))
                                {
                                    <span><i class="bi bi-diagram-3 me-1"></i>@post.Department</span>
                                }
                            </div>

                            @if (post.StartDate.HasValue && post.EndDate.HasValue)
                            {
                                <div class="text-muted small mb-3">
                                    <i class="bi bi-calendar me-1"></i>
                                    @post.StartDate.Value.ToString("dd.MM.yyyy") — @post.EndDate.Value.ToString("dd.MM.yyyy")
                                </div>
                            }

                            <div class="text-muted small mb-3">
                                <i class="bi bi-people me-1"></i>@post.Quota kontenjan
                            </div>

                            <div class="mt-auto">
                                <form method="post" action="/Student/ApplyToPost" enctype="multipart/form-data">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="internshipPostId" value="@post.Id" />
                                    <input type="hidden" name="position" value="@post.Title" />
                                    <input type="hidden" name="companyName" value="@(post.Company?.CompanyName ?? "")" />
                                    <div class="mb-3">
                                        <label class="form-label small fw-semibold">CV / Özgeçmiş</label>
                                        <input type="file" name="cvFile" class="form-control form-control-sm"
                                               accept=".pdf,.doc,.docx" required />
                                        <div class="form-text text-muted small">
                                            <i class="bi bi-info-circle me-1"></i>PDF veya Word, max 5MB
                                        </div>
                                    </div>
                                    <button type="submit" class="btn btn-primary rounded-pill w-100 fw-semibold">
                                        <i class="bi bi-send me-2"></i>Başvur
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="card border-0 rounded-3 shadow-sm">
                <div class="card-body text-center py-5 text-muted">
                    <i class="bi bi-search fs-1 d-block mb-3"></i>
                    <h6>Henüz aktif ilan yok</h6>
                    <p class="small">Şirketler henüz staj ilanı yayınlamamış.</p>
                </div>
            </div>
        }

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>