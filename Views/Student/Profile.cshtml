@model StajTakip.Entities.Concrete.User
@{
    ViewData["Title"] = "Profilim";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Staj Takip — Profilim</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        body { background: #f0f4f8; }
        .sidebar {
            background: linear-gradient(180deg, #1e3a5f, #2e86de);
            min-height: 100vh; width: 240px;
            position: fixed; top: 0; left: 0;
            padding: 1.5rem 1rem; z-index: 100;
        }
        .sidebar .nav-link {
            color: rgba(255,255,255,0.75);
            border-radius: 8px; padding: 0.6rem 1rem;
            margin-bottom: 4px; transition: all 0.2s;
        }
        .sidebar .nav-link:hover, .sidebar .nav-link.active {
            background: rgba(255,255,255,0.15); color: #fff;
        }
        .main-content { margin-left: 240px; padding: 2rem; }
        .profile-card { border: none; border-radius: 16px; box-shadow: 0 2px 12px rgba(0,0,0,0.07); }
        .avatar { width: 80px; height: 80px; border-radius: 50%; background: linear-gradient(135deg, #1e3a5f, #2e86de); display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; font-size: 2rem; }
        .form-control:focus, .form-select:focus { border-color: #2e86de; box-shadow: 0 0 0 0.2rem rgba(46,134,222,0.25); }
    </style>
</head>
<body>

<div class="sidebar">
    <div class="text-white text-center mb-4">
        <i class="bi bi-briefcase-fill fs-3"></i>
        <div class="fw-bold mt-1">Staj Takip</div>
        <small class="opacity-75">@User.Identity?.Name</small>
    </div>
    <nav class="nav flex-column">
        <a href="/Student/Dashboard" class="nav-link">
            <i class="bi bi-speedometer2 me-2"></i>Dashboard
        </a>
        <a href="/Student/Applications" class="nav-link">
            <i class="bi bi-list-ul me-2"></i>Başvurularım
        </a>
        <a href="/Student/Internships" class="nav-link">
            <i class="bi bi-search me-2"></i>Staj İlanları
        </a>
        <a href="/Student/AddApplication" class="nav-link">
            <i class="bi bi-plus-circle me-2"></i>Manuel Başvuru
        </a>
        <a href="/Student/Profile" class="nav-link active">
            <i class="bi bi-person-circle me-2"></i>Profilim
        </a>
    </nav>
    <div class="position-absolute bottom-0 start-0 w-100 p-3">
            <a href="/Student/Profile" class="nav-link">
                <i class="bi bi-person-circle me-2"></i>Profilim
            </a>
            <a href="/Message/Inbox" class="nav-link">
                <i class="bi bi-chat-dots me-2"></i>Mesajlar
            </a>
        <a href="/Account/Logout" class="nav-link text-white-50">
            <i class="bi bi-box-arrow-left me-2"></i>Çıkış Yap
        </a>
    </div>
</div>

<div class="main-content">
    <div class="row justify-content-center">
        <div class="col-lg-7">

            <div class="mb-4">
                <h4 class="fw-bold mb-0">Profilim</h4>
                <small class="text-muted">Kişisel bilgilerinizi güncelleyin</small>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success border-0 rounded-3 py-2 mb-3">
                    <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger border-0 rounded-3 py-2 mb-3">
                    <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
                </div>
            }

            <!-- Avatar ve isim -->
            <div class="card profile-card p-4 mb-4">
                <div class="d-flex align-items-center gap-4">
                    <div class="avatar">@Model.FullName[0]</div>
                    <div>
                        <h5 class="fw-bold mb-1">@Model.FullName</h5>
                        <div class="text-muted small">@Model.Email</div>
                        <span class="badge bg-primary bg-opacity-10 text-primary mt-1">Öğrenci</span>
                    </div>
                </div>
            </div>

            <!-- Profil formu -->
            <div class="card profile-card p-4">
                <form method="post" action="/Student/Profile">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Ad Soyad <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <input type="text" name="fullName" class="form-control"
                                   value="@Model.FullName" required minlength="3" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Telefon</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                            <input type="tel" name="phoneNumber" class="form-control"
                                   value="@Model.PhoneNumber" placeholder="05XX XXX XX XX" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Öğrenci Numarası</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-hash"></i></span>
                            <input type="text" name="studentNumber" class="form-control"
                                   value="@Model.StudentNumber" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Bölüm</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-book"></i></span>
                                <select name="department" class="form-select">
                                    <option value="">— Bölüm seçin —</option>
                                    <option value="Bilgisayar Mühendisliği" selected="@(Model.Department == "Bilgisayar Mühendisliği" ? "selected" : null)">Bilgisayar Mühendisliği</option>
                                    <option value="Yazılım Mühendisliği" selected="@(Model.Department == "Yazılım Mühendisliği" ? "selected" : null)">Yazılım Mühendisliği</option>
                                    <option value="Bilgisayar Teknolojisi" selected="@(Model.Department == "Bilgisayar Teknolojisi" ? "selected" : null)">Bilgisayar Teknolojisi</option>
                                </select>
                        </div>
                    </div>

                    <!-- E-posta (salt okunur) -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold">E-posta</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input type="email" class="form-control" value="@Model.Email" disabled />
                        </div>
                        <div class="form-text text-muted small">E-posta adresi değiştirilemez.</div>
                    </div>

                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold">
                        <i class="bi bi-check-lg me-2"></i>Güncelle
                    </button>
                </form>
            </div>

        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>