@model List<StajTakip.Entities.Concrete.Application>
@{
    ViewData["Title"] = "Dashboard";
    var summary = ViewBag.Summary as Dictionary<StajTakip.Entities.Concrete.ApplicationStatus, int>;
    var notifs = ViewBag.Notifs as List<StajTakip.Entities.Concrete.Notification>;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Staj Takip — Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        body {
            background: #f0f4f8;
        }

        .sidebar {
            background: linear-gradient(180deg, #1e3a5f, #2e86de);
            min-height: 100vh;
            width: 240px;
            position: fixed;
            top: 0;
            left: 0;
            padding: 1.5rem 1rem;
            z-index: 100;
        }

            .sidebar .nav-link {
                color: rgba(255,255,255,0.75);
                border-radius: 8px;
                padding: 0.6rem 1rem;
                margin-bottom: 4px;
                transition: all 0.2s;
            }

                .sidebar .nav-link:hover, .sidebar .nav-link.active {
                    background: rgba(255,255,255,0.15);
                    color: #fff;
                }

        .main-content {
            margin-left: 240px;
            padding: 2rem;
        }

        .stat-card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.07);
        }

        .stat-icon {
            width: 48px;
            height: 48px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
        }

        .app-table {
            border: none;
            border-radius: 12px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.07);
            overflow: hidden;
        }

        .badge-status {
            font-size: 0.75rem;
            padding: 0.4em 0.8em;
            border-radius: 20px;
        }

        .notif-dot {
            width: 8px;
            height: 8px;
            background: #e74c3c;
            border-radius: 50%;
            display: inline-block;
        }
    </style>
</head>
<body>

    <!-- Sidebar -->
    <div class="sidebar">
        <div class="text-white text-center mb-4">   
            <i class="bi bi-briefcase-fill fs-3"></i>
            <div class="fw-bold mt-1">Staj Takip</div>
            <small class="opacity-75">@User.Identity?.Name</small>
        </div>
        <nav class="nav flex-column">
            <a href="/Student/Dashboard" class="nav-link active">
                <i class="bi bi-speedometer2 me-2"></i>Dashboard
            </a>
            <a href="/Student/Applications" class="nav-link">
                <i class="bi bi-list-ul me-2"></i>Başvurularım
            </a>
            <a href="/Student/Internships" class="nav-link">
                <i class="bi bi-search me-2"></i>Staj İlanları
            </a>
            <a href="/Student/AddApplication" class="nav-link active">
                <i class="bi bi-plus-circle me-2"></i>Manuel Başvuru
            </a>
        </nav>
        <div class="position-absolute bottom-0 start-0 w-100 p-3">
            <a href="/Student/Profile" class="nav-link text-white-50">
                <i class="bi bi-person-circle me-2"></i>Profilim
            </a>
            <a href="/Message/Inbox" class="nav-link">
                <i class="bi bi-chat-dots me-2"></i>Mesajlar
                @if (ViewBag.UnreadMessages != null && ViewBag.UnreadMessages > 0)
                {
                    <span class="badge bg-danger ms-1">@ViewBag.UnreadMessages</span>
                }
            </a>
            <a href="/Account/Logout" class="nav-link text-white-50">
                <i class="bi bi-box-arrow-left me-2"></i>Çıkış Yap
            </a>
        </div>
    </div>

    <!-- Ana içerik -->
    <div class="main-content">

        <!-- Başlık -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h4 class="fw-bold mb-0">Hoş geldiniz 👋</h4>
                <small class="text-muted">Başvuru durumlarınıza genel bakış</small>
            </div>
            <a href="/Student/AddApplication" class="btn btn-primary rounded-pill px-4">
                <i class="bi bi-plus-lg me-1"></i>Yeni Başvuru
            </a>
        </div>

        <!-- Bildirimler -->
        @if (notifs != null && notifs.Any())
        {
            <div class="alert alert-info border-0 rounded-3 mb-4 py-2">
                <i class="bi bi-bell-fill me-2"></i>
                <strong>@notifs.Count</strong> okunmamış bildiriminiz var.
                <a href="#notifications" class="alert-link ms-2">Görüntüle</a>
            </div>
        }

        <!-- İstatistik kartları -->
        <div class="col-6 col-lg-3 mb-2 " style="width:235px;">
            <div class="card stat-card p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon bg-dark bg-opacity-10">
                        <i class="bi bi-collection text-dark"></i>
                    </div>
                    <div>
                        <div class="fw-bold fs-4">@(ViewBag.Total ?? 0)</div>
                        <div class="small text-muted">Toplam Başvuru</div>
                    </div>
                </div>
            </div>
        </div>


        <div class="row g-3 mb-4">
            <div class="col-6 col-lg-2">
                <div class="card stat-card p-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="stat-icon bg-dark bg-opacity-10">
                            <i class="bi bi-collection text-dark"></i>
                        </div>
                        <div>
                            <div class="fw-bold fs-4">@(ViewBag.Total ?? 0)</div>
                            <div class="small text-muted">Toplam</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-2">
                <div class="card stat-card p-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="stat-icon bg-primary bg-opacity-10">
                            <i class="bi bi-send text-primary"></i>
                        </div>
                        <div>
                            <div class="fw-bold fs-4">@(summary?.GetValueOrDefault(StajTakip.Entities.Concrete.ApplicationStatus.Sent, 0))</div>
                            <div class="small text-muted">Gönderildi</div>
                        </div>
                    </div>
                </div>
            </div>
           
            <div class="col-6 col-lg-2">
                <div class="card stat-card p-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="stat-icon bg-success bg-opacity-10">
                            <i class="bi bi-check-circle text-success"></i>
                        </div>
                        <div>
                            <div class="fw-bold fs-4">@(summary?.GetValueOrDefault(StajTakip.Entities.Concrete.ApplicationStatus.Accepted, 0))</div>
                            <div class="small text-muted">Kabul</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-2">
                <div class="card stat-card p-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="stat-icon bg-danger bg-opacity-10">
                            <i class="bi bi-x-circle text-danger"></i>
                        </div>
                        <div>
                            <div class="fw-bold fs-4">@(summary?.GetValueOrDefault(StajTakip.Entities.Concrete.ApplicationStatus.Rejected, 0))</div>
                            <div class="small text-muted">Reddedildi</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-2">
                <div class="card stat-card p-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="stat-icon bg-secondary bg-opacity-10">
                            <i class="bi bi-clock text-secondary"></i>
                        </div>
                        <div>
                            <div class="fw-bold fs-4">@(summary?.GetValueOrDefault(StajTakip.Entities.Concrete.ApplicationStatus.Planned, 0))</div>
                            <div class="small text-muted">Planlandı</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Son başvurular -->
        <div class="card app-table mb-4">
            <div class="card-header bg-white border-0 pt-3 pb-0 px-4">
                <div class="d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0">Son Başvurular</h6>
                    <a href="/Student/Applications" class="btn btn-sm btn-outline-primary rounded-pill">Tümünü Gör</a>
                </div>
            </div>
            <div class="card-body px-4">
                @if (Model != null && Model.Any())
                {
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Şirket / Pozisyon</th>
                                <th>Tarih</th>
                                <th>Durum</th>
                                <th>Danışman Onayı</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var app in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@(app.CompanyName ?? app.InternshipPost?.Title ?? "-")</div>
                                        <small class="text-muted">@app.Position</small>
                                    </td>
                                    <td><small>@(app.ApplicationDate?.ToString("dd.MM.yyyy") ?? "-")</small></td>
                                    <td>
                                        @{
                                            var (bg, icon) = app.Status switch
                                            {
                                                StajTakip.Entities.Concrete.ApplicationStatus.Planned => ("secondary", "clock"),
                                                StajTakip.Entities.Concrete.ApplicationStatus.Sent => ("primary", "send"),
                                                StajTakip.Entities.Concrete.ApplicationStatus.Interview => ("warning", "chat-dots"),
                                                StajTakip.Entities.Concrete.ApplicationStatus.Offer => ("info", "envelope-open"),
                                                StajTakip.Entities.Concrete.ApplicationStatus.Accepted => ("success", "check-circle"),
                                                StajTakip.Entities.Concrete.ApplicationStatus.Rejected => ("danger", "x-circle"),
                                                _ => ("secondary", "question")
                                            };
                                            var label = app.Status switch
                                            {
                                                StajTakip.Entities.Concrete.ApplicationStatus.Planned => "Planlandı",
                                                StajTakip.Entities.Concrete.ApplicationStatus.Sent => "Gönderildi",
                                                StajTakip.Entities.Concrete.ApplicationStatus.Interview => "Mülakat",
                                                StajTakip.Entities.Concrete.ApplicationStatus.Offer => "Teklif",
                                                StajTakip.Entities.Concrete.ApplicationStatus.Accepted => "Kabul",
                                                StajTakip.Entities.Concrete.ApplicationStatus.Rejected => "Reddedildi",
                                                _ => "-"
                                            };
                                        }
                                        <span class="badge bg-@bg bg-opacity-10 text-@bg badge-status">
                                            <i class="bi bi-@icon me-1"></i>@label
                                        </span>
                                    </td>
                                    <td>
                                        @{
                                            var (abg, alabel) = app.AdvisorApproval switch
                                            {
                                                StajTakip.Entities.Concrete.AdvisorApprovalStatus.Pending => ("warning", "Bekliyor"),
                                                StajTakip.Entities.Concrete.AdvisorApprovalStatus.Approved => ("success", "Onaylandı"),
                                                StajTakip.Entities.Concrete.AdvisorApprovalStatus.Rejected => ("danger", "Reddedildi"),
                                                _ => ("secondary", "-")
                                            };
                                        }
                                        <span class="badge bg-@abg bg-opacity-10 text-@abg badge-status">@alabel</span>
                                    </td>
                                    <td>
                                        <a href="/Student/Detail/@app.Id" class="btn btn-sm btn-outline-secondary rounded-pill">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                        Henüz başvuru yok.
                        <a href="/Student/AddApplication" class="d-block mt-2">İlk başvuruyu ekle</a>
                    </div>
                }
            </div>
        </div>

        <!-- Bildirimler -->
        @if (notifs != null && notifs.Any())
        {
            <div class="card app-table" id="notifications">
                <div class="card-header bg-white border-0 pt-3 pb-0 px-4">
                    <h6 class="fw-bold mb-0"><i class="bi bi-bell me-2"></i>Bildirimler</h6>
                </div>
                <div class="card-body px-4">
                    @foreach (var notif in notifs)
                    {
                        <div class="d-flex align-items-start gap-3 py-2 border-bottom">
                            <div class="mt-1">
                                @{
                                    var nicon = notif.Type switch
                                    {
                                        StajTakip.Entities.Concrete.NotificationType.Success => "check-circle-fill text-success",
                                        StajTakip.Entities.Concrete.NotificationType.Danger => "x-circle-fill text-danger",
                                        StajTakip.Entities.Concrete.NotificationType.Warning => "exclamation-triangle-fill text-warning",
                                        _ => "info-circle-fill text-primary"
                                    };
                                }
                                <i class="bi bi-@nicon"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="fw-semibold small">@notif.Title</div>
                                <div class="text-muted small">@notif.Message</div>
                                <div class="text-muted" style="font-size:0.7rem">@notif.CreatedAt.ToString("dd.MM.yyyy HH:mm")</div>
                            </div>
                            <button class="btn btn-sm btn-outline-secondary rounded-pill"
                                    onclick="markRead(@notif.Id)">
                                <i class="bi bi-check2"></i>
                            </button>
                        </div>
                    }
                </div>
            </div>
        }

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        async function markRead(id) {
            await fetch('/Student/MarkNotifRead/' + id, { method: 'POST' });
            location.reload();
        }
    </script>
</body>
</html>