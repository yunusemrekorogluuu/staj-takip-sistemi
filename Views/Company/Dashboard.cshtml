@model List<StajTakip.Entities.Concrete.Application>
@{
    ViewData["Title"] = "Şirket Dashboard";
    var notifs = ViewBag.Notifs as List<StajTakip.Entities.Concrete.Notification>;
    var summary = ViewBag.Summary as Dictionary<string, int>;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Staj Takip — Şirket Paneli</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        body { background: #f0f4f8; }
        .sidebar {
            background: linear-gradient(180deg, #0d5c3a, #1a9e5f);
            min-height: 100vh; width: 240px;
            position: fixed; top: 0; left: 0;
            padding: 1.5rem 1rem; z-index: 100;
        }
        .sidebar .nav-link {
            color: rgba(255,255,255,0.75);
            border-radius: 8px; padding: 0.6rem 1rem;
            margin-bottom: 4px; transition: all 0.2s;
        }
        .sidebar .nav-link:hover, .sidebar .nav-link.active {
            background: rgba(255,255,255,0.15); color: #fff;
        }
        .main-content { margin-left: 240px; padding: 2rem; }
        .stat-card { border: none; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,0.07); }
        .stat-icon { width: 48px; height: 48px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; }
        .app-card { border: none; border-radius: 12px; box-shadow: 0 2px 12px rgba(0,0,0,0.07); transition: transform 0.2s; }
        .app-card:hover { transform: translateY(-2px); }
        .badge-status { font-size: 0.75rem; padding: 0.4em 0.8em; border-radius: 20px; }
    </style>
</head>
<body>

<!-- Sidebar -->
<div class="sidebar">
    <div class="text-white text-center mb-4">
        <i class="bi bi-building fs-3"></i>
        <div class="fw-bold mt-1">Staj Takip</div>
        <small class="opacity-75">@User.Identity?.Name</small>
    </div>
    <nav class="nav flex-column">
        <a href="/Company/Dashboard" class="nav-link active">
            <i class="bi bi-speedometer2 me-2"></i>Dashboard
        </a>
        <a href="/Company/Applications" class="nav-link">
            <i class="bi bi-list-ul me-2"></i>Başvurular
        </a>
        <a href="/Company/MyPosts" class="nav-link">
            <i class="bi bi-megaphone me-2"></i>İlanlarım
        </a>
        <a href="/Company/PostInternship" class="nav-link">
            <i class="bi bi-plus-circle me-2"></i>İlan Yayınla
        </a>
    </nav>
    <div class="position-absolute bottom-0 start-0 w-100 p-3">
            <a href="/Company/Profile" class="nav-link">
                <i class="bi bi-person-circle me-2"></i>Profilim
            </a>
            <a href="/Message/Inbox" class="nav-link">
                <i class="bi bi-chat-dots me-2"></i>Mesajlar
                @if (ViewBag.UnreadMessages != null && ViewBag.UnreadMessages > 0)
                {
                    <span class="badge bg-danger ms-1">@ViewBag.UnreadMessages</span>
                }
            </a>
        <a href="/Account/Logout" class="nav-link text-white-50">
            <i class="bi bi-box-arrow-left me-2"></i>Çıkış Yap
        </a>
    </div>
</div>

<!-- Ana içerik -->
<div class="main-content">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-0">Hoş geldiniz 👋</h4>
            <small class="text-muted">Staj başvurularını yönetin</small>
        </div>
        <a href="/Company/PostInternship" class="btn btn-success rounded-pill px-4">
            <i class="bi bi-plus-lg me-1"></i>İlan Yayınla
        </a>
    </div>

    @if (notifs != null && notifs.Any())
    {
        <div class="alert alert-info border-0 rounded-3 mb-4 py-2">
            <i class="bi bi-bell-fill me-2"></i>
            <strong>@notifs.Count</strong> okunmamış bildiriminiz var.
        </div>
    }

    <!-- İstatistik kartları -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card stat-card p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon bg-primary bg-opacity-10">
                        <i class="bi bi-people text-primary"></i>
                    </div>
                    <div>
                        <div class="fw-bold fs-4">@(summary?.GetValueOrDefault("Toplam", 0))</div>
                        <div class="small text-muted">Toplam Başvuru</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card stat-card p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon bg-warning bg-opacity-10">
                        <i class="bi bi-hourglass-split text-warning"></i>
                    </div>
                    <div>
                        <div class="fw-bold fs-4">@(summary?.GetValueOrDefault("Bekleyen", 0))</div>
                        <div class="small text-muted">Bekleyen</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card stat-card p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon bg-info bg-opacity-10">
                        <i class="bi bi-chat-dots text-info"></i>
                    </div>
                    <div>
                        <div class="fw-bold fs-4">@(summary?.GetValueOrDefault("Mülakat", 0))</div>
                        <div class="small text-muted">Mülakat</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card stat-card p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon bg-success bg-opacity-10">
                        <i class="bi bi-check-circle text-success"></i>
                    </div>
                    <div>
                        <div class="fw-bold fs-4">@(summary?.GetValueOrDefault("Kabul", 0))</div>
                        <div class="small text-muted">Kabul</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Son başvurular -->
    <div class="card stat-card">
        <div class="card-header bg-white border-0 pt-3 pb-0 px-4">
            <div class="d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0">Son Başvurular</h6>
                <a href="/Company/Applications" class="btn btn-sm btn-outline-success rounded-pill">Tümünü Gör</a>
            </div>
        </div>
        <div class="card-body px-4">
            @if (Model != null && Model.Any())
            {
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Öğrenci</th>
                            <th>Pozisyon</th>
                            <th>Tarih</th>
                            <th>Durum</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var app in Model)
                        {
                            
                                var (bg, label) = app.Status switch
                                {
                                    StajTakip.Entities.Concrete.ApplicationStatus.Sent      => ("primary", "Bekliyor"),
                                    StajTakip.Entities.Concrete.ApplicationStatus.Interview => ("warning", "Mülakat"),
                                    StajTakip.Entities.Concrete.ApplicationStatus.Accepted  => ("success", "Kabul"),
                                    StajTakip.Entities.Concrete.ApplicationStatus.Rejected  => ("danger", "Red"),
                                    _ => ("secondary", "-")
                                };
                            
                            <tr>
                                <td>
                                    <div class="fw-semibold">@app.Student?.FullName</div>
                                    <small class="text-muted">@app.Student?.Department</small>
                                </td>
                                <td><small>@app.Position</small></td>
                                <td><small>@(app.ApplicationDate?.ToString("dd.MM.yyyy") ?? "-")</small></td>
                                <td>
                                    <span class="badge bg-@bg bg-opacity-10 text-@bg badge-status">@label</span>
                                </td>
                                <td>
                                    <a href="/Company/ApplicationDetail/@app.Id"
                                       class="btn btn-sm btn-outline-secondary rounded-pill">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                    Henüz başvuru yok.
                </div>
            }
        </div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>