@model List<StajTakip.Entities.Concrete.Message>
@{
    ViewData["Title"] = "Konuşma";
    var otherUser = ViewBag.OtherUser as StajTakip.Entities.Concrete.User;
    var currentUserId = (int)ViewBag.CurrentUserId;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Staj Takip — Konuşma</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        body {
            background: #f0f4f8;
        }

        .sidebar {
            background: linear-gradient(180deg, #1e3a5f, #2e86de);
            min-height: 100vh;
            width: 240px;
            position: fixed;
            top: 0;
            left: 0;
            padding: 1.5rem 1rem;
            z-index: 100;
        }

            .sidebar .nav-link {
                color: rgba(255,255,255,0.75);
                border-radius: 8px;
                padding: 0.6rem 1rem;
                margin-bottom: 4px;
                transition: all 0.2s;
            }

                .sidebar .nav-link:hover, .sidebar .nav-link.active {
                    background: rgba(255,255,255,0.15);
                    color: #fff;
                }

        .main-content {
            margin-left: 240px;
            padding: 2rem;
        }

        .chat-box {
            height: 500px;
            overflow-y: auto;
            background: #f8f9fa;
            border-radius: 12px;
            padding: 1.5rem;
        }

        .message-sent {
            display: flex;
            justify-content: flex-end;
            margin-bottom: 1rem;
        }

        .message-received {
            display: flex;
            justify-content: flex-start;
            margin-bottom: 1rem;
        }

        .message-bubble {
            max-width: 320px;
            min-width: 80px;
            padding: 0.75rem 1rem;
            border-radius: 16px;
            font-size: 0.9rem;
            word-break: break-word;
        }

        .bubble-sent {
            background: linear-gradient(135deg, #1e3a5f, #2e86de);
            color: white;
            border-radius: 16px 16px 4px 16px;
        }

        .bubble-received {
            background: white;
            color: #333;
            border-radius: 16px 16px 16px 4px;
            box-shadow: 0 1px 4px rgba(0,0,0,0.08);
        }

        .avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: bold;
            font-size: 0.9rem;
            flex-shrink: 0;
        }

        .chat-input {
            border-radius: 12px;
            border: 1px solid #dee2e6;
            padding: 0.75rem 1rem;
            resize: none;
        }

            .chat-input:focus {
                border-color: #2e86de;
                box-shadow: 0 0 0 0.2rem rgba(46,134,222,0.25);
                outline: none;
            }
    </style>
</head>
<body>

    <div class="sidebar">
        <div class="text-white text-center mb-4">
            <i class="bi bi-briefcase-fill fs-3"></i>
            <div class="fw-bold mt-1">Staj Takip</div>
            <small class="opacity-75">@User.Identity?.Name</small>
        </div>
        <nav class="nav flex-column">
            @{
                var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
            }
            @if (role == "Student")
            {
                <a href="/Student/Dashboard" class="nav-link"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a>
                <a href="/Student/Applications" class="nav-link"><i class="bi bi-list-ul me-2"></i>Başvurularım</a>
                <a href="/Student/Internships" class="nav-link"><i class="bi bi-search me-2"></i>Staj İlanları</a>
            }
            else if (role == "Advisor")
            {
                <a href="/Advisor/Dashboard" class="nav-link"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a>
                <a href="/Advisor/Students" class="nav-link"><i class="bi bi-people me-2"></i>Öğrencilerim</a>
                <a href="/Advisor/PendingApprovals" class="nav-link"><i class="bi bi-hourglass-split me-2"></i>Onay Bekleyenler</a>
            }
            else if (role == "Company")
            {
                <a href="/Company/Dashboard" class="nav-link"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a>
                <a href="/Company/Applications" class="nav-link"><i class="bi bi-list-ul me-2"></i>Başvurular</a>
                <a href="/Company/MyPosts" class="nav-link"><i class="bi bi-megaphone me-2"></i>İlanlarım</a>
            }
            <a href="/Message/Inbox" class="nav-link active"><i class="bi bi-chat-dots me-2"></i>Mesajlar</a>
            <a href="/Message/NewMessage" class="nav-link"><i class="bi bi-pencil-square me-2"></i>Yeni Mesaj</a>
        </nav>
        <div class="position-absolute bottom-0 start-0 w-100 p-3">
            <a href="/Account/Logout" class="nav-link text-white-50">
                <i class="bi bi-box-arrow-left me-2"></i>Çıkış Yap
            </a>
        </div>
    </div>

    <div class="main-content">

        <!-- Başlık -->
        <div class="mb-4">
            <a href="/Message/Inbox" class="text-decoration-none text-muted small">
                <i class="bi bi-arrow-left me-1"></i>Mesajlara dön
            </a>
            <div class="d-flex align-items-center gap-3 mt-2">
                @{
                    var avatarBg = otherUser?.Role?.Name == "Advisor" ? "#6f42c1" :
                    otherUser?.Role?.Name == "Company" ? "#1a9e5f" : "#2e86de";
                }
                <div class="avatar" style="background:@avatarBg;width:48px;height:48px;font-size:1.2rem">
                    @(otherUser?.FullName?[0] ?? '?')
                </div>
                <div>
                    <h5 class="fw-bold mb-0">@otherUser?.FullName</h5>
                    <small class="text-muted">@otherUser?.Email</small>
                </div>
            </div>
        </div>

        <!-- Mesajlar -->
        <div class="chat-box mb-3" id="chatBox">
            @if (Model != null && Model.Any())
            {
                @foreach (var msg in Model)
                {
                    var isSent = msg.SenderId == currentUserId;
                    <div class="@(isSent ? "message-sent" : "message-received")">
                        @if (!isSent)
                        {
                            <div class="avatar me-2" style="background:@avatarBg">
                                @(otherUser?.FullName?[0] ?? '?')
                            </div>
                        }
                        <div>
                            <div class="message-bubble @(isSent ? "bubble-sent" : "bubble-received")">
                                @msg.Content
                            </div>
                            <div class="text-muted mt-1" style="font-size:0.7rem;text-align:@(isSent ? "right" : "left")">
                                @msg.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                                @if (isSent)
                                {
                                    <i class="bi bi-check2 ms-1"></i>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center text-muted py-5">
                    <i class="bi bi-chat fs-1 d-block mb-2"></i>
                    Henüz mesaj yok. İlk mesajı siz gönderin!
                </div>
            }
        </div>

        <!-- Mesaj gönder -->
        <div class="card border-0 rounded-3 shadow-sm p-3">
            <form method="post" action="/Message/Send" id="messageForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="receiverId" value="@otherUser?.Id" />
                <input type="hidden" name="applicationId" value="" />
                <div class="d-flex gap-2 align-items-end">
                    <textarea name="content" id="messageInput" class="form-control chat-input flex-grow-1"
                              rows="2" placeholder="Mesajınızı yazın..."
                              onkeydown="handleEnter(event)"></textarea>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold">
                        <i class="bi bi-send"></i>
                    </button>
                </div>
            </form>
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Sayfа açılınca en alta scroll
        const chatBox = document.getElementById('chatBox');
        chatBox.scrollTop = chatBox.scrollHeight;

        // Enter ile gönder, Shift+Enter ile yeni satır
        function handleEnter(e) {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                const content = document.getElementById('messageInput').value.trim();
                if (content) document.getElementById('messageForm').submit();
            }
        }
    </script>
</body>
</html>